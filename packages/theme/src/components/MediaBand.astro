---
import Media from './Media.astro'
import { telHref } from '../fill.ts'
import type { ImageSlot } from '../config.ts'

interface Props { id: string; image: ImageSlot; heading: string; body: string; points: string[]; phone: string }
const { id, image, heading, body, points, phone } = Astro.props
---
<section class="band section">
  <div class="shell band-in">
    <div class="band-media"><Media id={id} image={image} ratio="4 / 3" /></div>
    <div>
      <p class="eyebrow eyebrow-dark">Why homeowners call us back</p>
      <h2 set:html={heading} />
      <p class="lede">{body}</p>
      <ul class="points">
        {points.map((point) => <li><span aria-hidden="true">+</span>{point}</li>)}
      </ul>
      <a class="btn" href={telHref(phone)} data-cta="band-call">Call {phone}</a>
    </div>
  </div>
</section>

<style>
  .band-in { align-items: center; display: grid; gap: clamp(28px, 5vw, 60px); grid-template-columns: 1fr 1fr; }
  .points { margin: 26px 0 30px; }
  .points li { border-bottom: 1px solid var(--line); font-size: 14px; padding: 12px 0; }
  .points span { color: var(--accent); margin-right: 14px; }
  @media (max-width: 820px) { .band-in { grid-template-columns: 1fr; } }
</style>
